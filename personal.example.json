{
 "_help": "Copy to ~/.config/wealth-ledger/personal.json (chmod 600) and replace every value with your own. Keys starting with _ are comments.",
 "sheet_id": "YOUR-GOOGLE-SHEET-ID",
 "networth": {
  "_help": "Balance-sheet tab labels (column A, exact). synced: label -> account_name LIKE patterns (as shown in v_accounts) whose live balance replaces the sheet value.",
  "synced": {
   "Checking": ["Example Bank Checking (0000)"],
   "Savings": ["Example Bank Savings%"],
   "Brokerage": ["Individual Brokerage%"],
   "Roth IRA": ["ROTH IRA%"],
   "Mortgage": ["MORTGAGE LOAN%"],
   "Credit card": ["Example Rewards Card%"]
  },
  "asset_rows": ["Checking", "Savings", "Brokerage", "Roth IRA", "Cash", "Total cryptocurrency (USD)*",
                 "Total metals value*", "Home", "Car"],
  "liab_rows": ["Mortgage", "Credit card"],
  "sheet_excluded": []
 },
 "rules": [
  [10, "%EXAMPLE CARD PYMT%", "checking", "out", "card_payment", "checking-side payment to your card"],
  [20, "%EXAMPLE BANK XFER%", null, null, "transfer", "transfer between your own accounts"],
  [30, "%EXAMPLE BULLION DEALER%", null, "out", "investment", "precious metals"]
 ],
 "home": {
  "asset": "Home",
  "address": "123 Example St, Springfield, ST 00000",
  "search_text": "123 Example St, Springfield, ST",
  "suggestion_text": "123 Example St",
  "comehome_slug": "123-Example-St-Springfield-ST-00000",
  "cad_office": "Example",
  "cad_host": "example.prodigycad.com",
  "cad_pid": "000000",
  "cad_note": "appraisal-district market value as of Jan 1"
 },
 "cars": {
  "zip": "00000",
  "radius": 150,
  "state": "ST",
  "cars": [
   {
    "asset": "Car",
    "vehicle": "2020 Example Motors Sedan LX FWD",
    "vin": "VIN-OF-YOUR-CAR",
    "vin_source": "where the VIN came from",
    "make": "examplemotors",
    "model": "sedan",
    "year": 2020,
    "years": [2019, 2021],
    "year_adj": 0.06,
    "odometer": [50000, "2026-01-01", "where the odometer reading came from"],
    "miles_per_year": 10000,
    "sanity": "optional note, e.g. a dealer trade-in estimate",
    "pools": [
     {"name": "LX trim", "trim_ok": "^lx$", "reject": "sport|touring"},
     {"name": "LX, VIN-filtered", "trim_ok": "\\blx\\b", "reject": "sport", "vin": {"drive": "fwd", "max_l": 2.0}}
    ]
   }
  ]
 },
 "crypto": {
  "_help": "exchange_rows: wallets that have their own balance-sheet row (only coins the crypto total counts are counted there).",
  "exchange_rows": ["ExchangeA", "ExchangeB"],
  "default_wallet": "Wallet",
  "xpub_export_dir": "",
  "xpub_export_wallet": "Wallet"
 },
 "dashboard": {
  "_help": "exact: networth.py line label -> category; rules: [regex, category] fallbacks tried in order. Categories: cash retirement taxable crypto metals realestate vehicles other.",
  "default_username": "admin",
  "ledger_start": "2026-01-01",
  "exact": {
   "Brokerage": "taxable",
   "Total cryptocurrency (USD)": "crypto",
   "Total metals value": "metals",
   "Home": "realestate",
   "Cash": "cash",
   "Mortgage": "mortgage"
  },
  "rules": [
   ["\\b(ira|roth|401\\(?k|403b|hsa|pre-tax|pension)\\b", "retirement"],
   ["checking|savings|bank|cash|wallet", "cash"],
   ["crypto|bitcoin", "crypto"],
   ["metal|gold|silver", "metals"],
   ["home|house|property", "realestate"],
   ["car\\b|truck|vehicle", "vehicles"],
   ["brokerage|individual|taxable", "taxable"]
  ]
 },
 "plaid": {"client_user_id": "wealth-ledger-user"},
 "simplefin_watch": {
  "_help": "bin/simplefin-institution-check: search SimpleFIN's institution list for these queries; ignore maps a query to the exact result that is already known.",
  "label": "the account you are waiting for",
  "queries": ["Example Card", "Example Issuer"],
  "ignore": {}
 }
}
