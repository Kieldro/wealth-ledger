# environments / tooling
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.env
.env.*
.claude/

# personal data and secrets: these live in ~/.config/wealth-ledger and ~/.local/share/wealth-ledger, never here
personal.json
!personal.example.json
*_auth.json
*_sessions.json
plaid.json
crypto_wallets.json
simplefin_access_url
apify_token
*.secret
*.key
*.pem

# databases, backups, logs, caches, browser profiles
*.db
*.db-*
*.sqlite*
*.bak*
*.tgz
*.tar.gz
*.log
*.csv
*.qfx
*.ofx
profiles/
cache/
.cache/

# screenshots contain real balances
dashboard/screenshots/
*.png
*.jpg
*.jpeg
*.webp
# except the app icons (a drawing, see dashboard/pwa/make_icons.py)
!dashboard/pwa/*.png
!android/store_icon.png
!android/app/src/main/res/**/*.png

# what the browser tests save when one fails (synthetic data)
dashboard/ui-artifacts/

# Android app (android/): build outputs, local SDK paths and signing keys never go in the repo
android/build-out/
android/**/build/
android/.gradle/
android/app/.gradle/
android/local.properties
android/.idea/
android/*.iml
android/**/*.jks
android/**/*.keystore
android/.bubblewrap/
*.apk
*.aab
*.idsig
