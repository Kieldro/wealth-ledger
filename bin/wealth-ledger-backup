#!/usr/bin/env bash
# Daily copy of the database to another disk (run by wealth-ledger-sync after each sync). SimpleFIN only serves
# ~90 days of history, so older history exists only in the database; this keeps it safe from losing that disk.
# Where it goes comes from personal.json "backup": {"dir": "/path/on/another/disk", "keep_days": 30}
# ($WEALTH_LEDGER_PERSONAL overrides the path, as in personal.py). No "backup" section = backups off.
# Writes <dir>/txns-YYYY-MM-DD.db.gz (mode 0600), checked with PRAGMA integrity_check before it replaces anything.
# Keeps keep_days of dailies plus every 1st-of-month copy. The dir must already exist (it is never created, so an
# unmounted drive is an error instead of a copy on the wrong disk). Exits non-zero with one error line on failure.
set -uo pipefail
umask 077
DB=${WEALTH_LEDGER_DB:-$HOME/.local/share/wealth-ledger/txns.db}
CFG=${WEALTH_LEDGER_PERSONAL:-$HOME/.config/wealth-ledger/personal.json}
TODAY=${WEALTH_LEDGER_TODAY:-$(date +%F)}
fail() { echo "error: $1" >&2; exit 1; }

[[ -f $CFG ]] || fail "$CFG not found"
read -r DIR KEEP < <(python3 -c 'import json,sys; b=json.load(open(sys.argv[1])).get("backup") or {}
print(b.get("dir") or "-", int(b.get("keep_days") or 30))' "$CFG") || fail "can't read backup settings from $CFG"
[[ $DIR == - ]] && { echo "backups off (no backup.dir in $CFG)"; exit 0; }
[[ -f $DB ]] || fail "database $DB not found"
[[ -d $DIR ]] || fail "backup folder $DIR missing (drive not mounted?)"

out=$DIR/txns-$TODAY.db.gz
tmp=$(mktemp "$DIR/.txns-XXXXXX.db") || fail "can't write to $DIR"
trap 'rm -f "$tmp" "$tmp.gz"' EXIT
sqlite3 "$DB" ".backup '$tmp'" || fail "sqlite backup of $DB failed"
ok=$(sqlite3 "$tmp" 'PRAGMA integrity_check' 2>&1)
[[ $ok == ok ]] || fail "backup copy failed integrity check: ${ok:0:200}"
gzip -9 "$tmp" && mv -f "$tmp.gz" "$out" || fail "can't write $out"

# prune dailies older than KEEP days; 1st-of-month copies stay
cutoff=$(date -d "$TODAY - $KEEP days" +%F)
for f in "$DIR"/txns-????-??-??.db.gz; do
  [[ -e $f ]] || continue
  d=${f##*/txns-}; d=${d%.db.gz}
  [[ $d < $cutoff && ${d:8:2} != 01 ]] && rm -f "$f"
done
echo "backup $out ($(du -h "$out" | cut -f1))"
